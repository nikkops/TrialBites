# Copy this file to .env.local and fill in your own values.
# Find them in Supabase: Project Settings -> API.
# Never put the service_role / secret key here: anything starting with VITE_
# ends up in the browser.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
